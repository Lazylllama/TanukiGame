    <ui:VisualElement style="flex-grow: initial; height: auto; flex-shrink: initial; flex-direction: row; justify-content: space-between; margin-left: 64px; margin-right: 64px; margin-top: 64px; margin-bottom: 64px;">
        <ui:VisualElement name="VisualElement" style="flex-grow: initial;">
            <ui:Label text="Skill tree" class="drop-shadow" style="font-size: 82px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Gaegu-Bold.ttf?fileID=12800000&amp;guid=ff250c4a0b8146c4386e547691509241&amp;type=3#Gaegu-Bold&quot;); color: rgb(220, 216, 207);"/>
            <ui:Label text="get better at being yourself? hmm" class="drop-shadow" style="font-size: 40px; color: rgb(220, 216, 207); -unity-font-definition: url(&quot;project://database/Assets/Fonts/Gaegu-Bold.ttf?fileID=12800000&amp;guid=ff250c4a0b8146c4386e547691509241&amp;type=3#Gaegu-Bold&quot;); opacity: 0.45; height: 52px;"/>
        </ui:VisualElement>
        <ui:Instance template="ExperienceCard" name="ExperienceContainer"/>
