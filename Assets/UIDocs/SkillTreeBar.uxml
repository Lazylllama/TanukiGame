    <ui:Instance template="BottomSkillList" name="BottomSkillList">
        <ui:Button text="&lt;- Main Menu" name="MainMenuButton" style="position: absolute; bottom: 70px; left: 100px; background-color: rgba(188, 188, 188, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; -unity-font-definition: url(&quot;project://database/Assets/Fonts/uglyhandwriting.ttf?fileID=12800000&amp;guid=4f741aaafd7179141a0f00b03480749d&amp;type=3#uglyhandwriting&quot;); padding-right: 9px; padding-left: 9px; padding-top: 9px; padding-bottom: 9px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; font-size: 32px; color: rgb(220, 216, 207); opacity: 0.5;"/>
    </ui:Instance>
