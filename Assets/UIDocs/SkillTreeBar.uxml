        <ui:Image source="project://database/Assets/Art/SkillTreeImage.png?fileID=2800000&amp;guid=1976e885109eda7469104b7f3b5b96aa&amp;type=3#SkillTreeImage" name="Tanuki" style="filter: drop-shadow(0 0 41.21 rgb(0, 0, 0));"/>
