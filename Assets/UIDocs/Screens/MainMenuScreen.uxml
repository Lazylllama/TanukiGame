<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Template name="ExperienceCard" src="project://database/Assets/UIDocs/Templates/ExperienceCard.uxml?fileID=9197481963319205126&amp;guid=2392ac3be16b6f145b21c9587b95a088&amp;type=3#ExperienceCard"/>
    <Style src="project://database/Assets/UIDocs/StyleSheet.uss?fileID=7433441132597879392&amp;guid=ef7d3e02e35b11a4ca1dd2e645fb08f7&amp;type=3#StyleSheet"/>
    <Style src="project://database/Assets/StartScreen.uss?fileID=7433441132597879392&amp;guid=73a629037fa84c54ba4be960139a1b8e&amp;type=3#StartScreen"/>
    <ui:VisualElement name="VisualElement" style="flex-grow: initial; width: initial; height: initial; flex-direction: column; align-items: flex-start; padding-left: 32px; padding-top: 32px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; position: absolute;">
        <ui:Instance template="ExperienceCard" name="ExperienceCard"/>
    </ui:VisualElement>
    <ui:VisualElement name="" enabled="true" style="flex-grow: 1; flex-basis: auto; width: 30%; background-color: rgba(0, 0, 0, 0); padding-top: 6px; padding-right: 6px; padding-bottom: 49px; padding-left: 4px; justify-content: center; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;">
        <ui:VisualElement name="Buttons" style="flex-grow: 1; justify-content: center; flex-direction: column-reverse; align-items: flex-start; padding-left: 40px; padding-top: 100px;">
            <ui:Button name="ExitButton" class="button">
                <ui:VisualElement class="arrow"/>
                <ui:Label text="Quit" class="button-title-red"/>
            </ui:Button>
            <ui:Button name="OptionsButton" enabled="true" class="button" style="align-items: center; justify-content: space-around; align-self: auto; white-space: normal; flex-direction: row; display: none;">
                <ui:VisualElement class="arrow"/>
                <ui:Label text="Options" class="button-title"/>
            </ui:Button>
            <ui:Button name="SkilltreeButton" enabled="true" class="button" style="align-items: center; justify-content: space-around; align-self: auto; white-space: normal; flex-direction: row; display: flex;">
                <ui:VisualElement class="arrow"/>
                <ui:Label text="Skilltree" class="button-title"/>
            </ui:Button>
            <ui:Button name="StartButton" class="button">
                <ui:VisualElement name="" class="arrow"/>
                <ui:Label text="Start" class="button-title"/>
            </ui:Button>
        </ui:VisualElement>
        <ui:Image source="project://database/Assets/Art/UI/TANUKI%20GAME.png?fileID=2800000&amp;guid=7886379483e91b942b2d27c4092e443a&amp;type=3#TANUKI GAME" style="padding-left: 52px; width: auto; height: 96px; background-position-x: center;"/>
    </ui:VisualElement>
</ui:UXML>
