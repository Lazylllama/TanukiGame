<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Template name="OptionRow" src="project://database/Assets/UIDocs/Templates/OptionRow.uxml?fileID=9197481963319205126&amp;guid=8a32366fcb4b19e4eaab14137a2de8be&amp;type=3#OptionRow"/>
    <Style src="project://database/Assets/UIDocs/StyleSheet.uss?fileID=7433441132597879392&amp;guid=ef7d3e02e35b11a4ca1dd2e645fb08f7&amp;type=3#StyleSheet"/>
    <ui:VisualElement style="flex-grow: 1;">
        <ui:Image source="project://database/Assets/Art/TempMainMenu.png?fileID=2800000&amp;guid=5b8c1478afe67ce4b97401820f5b0502&amp;type=3#TempMainMenu" scale-mode="ScaleAndCrop" style="position: absolute; flex-wrap: nowrap; flex-direction: column; align-items: auto; align-self: center; justify-content: space-around; align-content: auto; top: auto; width: 100%; height: 100%;"/>
        <ui:VisualElement name="MainScreen" class="screen" style="flex-grow: 1;">
            <ui:VisualElement name="StartScreen" enabled="true" class="screen" style="flex-grow: 1; flex-basis: auto; width: 30%; background-color: rgba(0, 0, 0, 0); padding-top: 6px; padding-right: 6px; padding-bottom: 6px; padding-left: 6px; justify-content: center;">
                <ui:Label text="Tanuki Game" style="height: 629px; justify-content: flex-start; -unity-text-align: middle-center; font-size: 100px; -unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/Fonts/uglyhandwriting.ttf?fileID=12800000&amp;guid=4f741aaafd7179141a0f00b03480749d&amp;type=3#uglyhandwriting&quot;); color: rgb(241, 221, 92);"/>
                <ui:VisualElement name="Buttons" style="flex-grow: 1; justify-content: center;">
                    <ui:Button name="StartButton" class="button">
                        <ui:VisualElement class="arrow"/>
                        <ui:Label text="Start" class="button-title" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/uglyhandwriting.ttf?fileID=12800000&amp;guid=4f741aaafd7179141a0f00b03480749d&amp;type=3#uglyhandwriting&quot;); color: rgb(255, 255, 255);"/>
                        <ui:VisualElement class="arrow"/>
                    </ui:Button>
                    <ui:Button name="OptionsButton" class="button">
                        <ui:VisualElement class="arrow"/>
                        <ui:Label text="Options" class="button-title" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/uglyhandwriting.ttf?fileID=12800000&amp;guid=4f741aaafd7179141a0f00b03480749d&amp;type=3#uglyhandwriting&quot;); color: rgb(255, 255, 255);"/>
                        <ui:VisualElement class="arrow"/>
                    </ui:Button>
                    <ui:Button name="ExitButton" class="button">
                        <ui:VisualElement class="arrow"/>
                        <ui:Label text="Exit" class="button-title" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/uglyhandwriting.ttf?fileID=12800000&amp;guid=4f741aaafd7179141a0f00b03480749d&amp;type=3#uglyhandwriting&quot;); color: rgb(255, 109, 109);"/>
                        <ui:VisualElement class="arrow"/>
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="OptionsScreen" class="screen screen--hidden">
                <ui:Label text="OPTIONS" style="font-size: 211px; -unity-text-align: middle-center; -unity-font-style: bold; -unity-text-auto-size: best-fit 10px 201px; -unity-text-generator: advanced; -unity-font-definition: url(&quot;project://database/Assets/Fonts/uglyhandwriting.ttf?fileID=12800000&amp;guid=4f741aaafd7179141a0f00b03480749d&amp;type=3#uglyhandwriting&quot;); padding-top: 4px; margin-top: 48px; background-image: none; color: rgb(255, 255, 255);"/>
                <ui:VisualElement name="Options" style="flex-grow: 1; align-items: center; justify-content: center; align-self: auto;">
                    <ui:Instance template="OptionRow"/>
                    <ui:Instance template="OptionRow"/>
                    <ui:Instance template="OptionRow"/>
                    <ui:Instance template="OptionRow"/>
                    <ui:Instance template="OptionRow"/>
                </ui:VisualElement>
                <ui:Button name="BackButton" class="button">
                    <ui:VisualElement class="arrow"/>
                    <ui:Label text="Back" class="button-title" style="color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/Fonts/uglyhandwriting.ttf?fileID=12800000&amp;guid=4f741aaafd7179141a0f00b03480749d&amp;type=3#uglyhandwriting&quot;);"/>
                    <ui:VisualElement class="arrow"/>
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
