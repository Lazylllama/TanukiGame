    <ui:Button name="Button" text="" class="drop-shadow" style="display: flex; background-color: rgba(0, 0, 0, 0); background-image: url(&quot;project://database/Assets/Art/UI/Components/SkillCard.png?fileID=2800000&amp;guid=fee9f74d6dd54e04b8576fe098c5d86c&amp;type=3#SkillCard&quot;); background-size: 100% 100%; width: 491px; height: 117px; padding-left: 16px; padding-right: 16px; padding-top: 14px; padding-bottom: 14px; margin-top: 42px; margin-left: 0; margin-right: 0; margin-bottom: 42px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; backdrop-filter: none; transition-duration: 350ms;">
        <ui:VisualElement name="TextStars" style="flex-grow: initial; flex-direction: row; align-items: center; justify-content: flex-start; align-self: flex-start;">
            <ui:Label text="Bullshit" name="SkillName" style="font-size: 36px; -unity-text-align: middle-left; white-space: normal; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Gaegu-Bold.ttf?fileID=12800000&amp;guid=ff250c4a0b8146c4386e547691509241&amp;type=3#Gaegu-Bold&quot;); height: auto; margin-top: 0; margin-right: 8px; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; color: rgb(220, 216, 207);"/>
            <ui:VisualElement name="Stars" style="flex-grow: 1; flex-direction: row; align-items: center; justify-content: flex-start; align-self: center;">
                <ui:Instance template="SkillStar" name="SkillStar"/>
                <ui:Instance template="SkillStar" name="SkillStar"/>
                <ui:Instance template="SkillStar" name="SkillStar"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label text="Lorem ipsum dolor sit amet, blah blahg vlah ahgoajs" name="SkillDescription" style="font-size: 15px; -unity-text-align: middle-left; white-space: normal; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Gaegu-Bold.ttf?fileID=12800000&amp;guid=ff250c4a0b8146c4386e547691509241&amp;type=3#Gaegu-Bold&quot;); height: auto; margin-top: 4px; margin-right: 0; margin-bottom: 4px; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; color: rgb(220, 216, 207); opacity: 0.75;"/>
        <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
            <ui:Label text="+15% attack speed" name="BeforeValue" style="font-size: 20px; -unity-text-align: middle-left; white-space: normal; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Gaegu-Bold.ttf?fileID=12800000&amp;guid=ff250c4a0b8146c4386e547691509241&amp;type=3#Gaegu-Bold&quot;); height: auto; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; color: rgb(236, 122, 114); opacity: 0.75;"/>
            <ui:Label text="➡️" name="Arrow" style="font-size: 20px; -unity-text-align: middle-left; white-space: normal; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Gaegu-Bold.ttf?fileID=12800000&amp;guid=ff250c4a0b8146c4386e547691509241&amp;type=3#Gaegu-Bold&quot;); height: auto; margin-top: 0; margin-right: 8px; margin-bottom: 0; margin-left: 8px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; color: rgb(75, 175, 139); opacity: 0.75; letter-spacing: -31px;"/>
            <ui:Label text="+15% attack speed" name="AfterValue" style="font-size: 20px; -unity-text-align: middle-left; white-space: normal; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Gaegu-Bold.ttf?fileID=12800000&amp;guid=ff250c4a0b8146c4386e547691509241&amp;type=3#Gaegu-Bold&quot;); height: auto; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; color: rgb(75, 175, 139); opacity: 0.75;"/>
        </ui:VisualElement>
    </ui:Button>
</ui:UXML>
