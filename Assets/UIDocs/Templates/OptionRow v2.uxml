<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Template name="CycleControl" src="project://database/Assets/UIDocs/Templates/CycleControl.uxml?fileID=9197481963319205126&amp;guid=bd31ee9be06992648a732cf1174870ba&amp;type=3#CycleControl"/>
