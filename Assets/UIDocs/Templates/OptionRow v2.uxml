    <ui:VisualElement name="OptionRow" class="option-row">
        <ui:VisualElement style="flex-grow: 1; align-self: flex-start; flex-wrap: wrap;">
            <ui:Label text="Automatic Input Detection" name="Label" class="Label Option-Label" style="-unity-text-align: middle-left;"/>
